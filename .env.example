# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=trialmind
POSTGRES_USER=trialmind
POSTGRES_PASSWORD=trialmind_secret
DATABASE_URL=postgresql://trialmind:trialmind_secret@postgres:5432/trialmind

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_S3_BUCKET=trialmind-models

# ── Services ──────────────────────────────────────────────────
ML_SERVICE_URL=http://ml:8001
AGENT_SERVICE_URL=http://agent:8002
MCP_SERVER_SCRIPT=/app/mcp-server/server.py

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=/api

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Model ─────────────────────────────────────────────────────
MODEL_VERSION=v1
